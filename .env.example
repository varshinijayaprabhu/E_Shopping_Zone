# ==============================================================================
# E-ShoppingZone Environment Configuration Template (.env.example)
# Capgemini Case Study — Microservices Architecture
# Note: Copy this file to .env or configure in system environment variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Relational Database Configuration (MySQL 8.4)
# ------------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_secure_mysql_password_here

# Individual Database Schemas (Created via scripts/init-databases.sql)
# profile_db   -> User profiles, authentication credentials, refresh tokens
# product_db   -> Product catalog, categories, inventory stock levels
# cart_db      -> Customer shopping carts and active line items
# wallet_db    -> Customer digital ledger, balances, transaction ledger
# order_db     -> Order state machine, line items, snapshot prices, sagas

# ------------------------------------------------------------------------------
# 2. Service Discovery & Networking
# ------------------------------------------------------------------------------
EUREKA_SERVER_URL=http://localhost:8761/eureka/
API_GATEWAY_PORT=8080
PROFILE_SERVICE_PORT=8081
PRODUCT_SERVICE_PORT=8082
CART_SERVICE_PORT=8083
ORDER_SERVICE_PORT=8084
WALLET_SERVICE_PORT=8085
FRONTEND_PORT=5173

# ------------------------------------------------------------------------------
# 3. Cryptography & Security Secrets
# ------------------------------------------------------------------------------
# 256-bit Hex-encoded HMAC-SHA256 Secret for JWT token generation and validation
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000

# Shared Secret for Inter-Service Internal Saga Endpoints (e.g., /reserve, /pay)
INTERNAL_SERVICE_SECRET=ESHOPPING_INTERNAL_SECRET_2026

# Administrative Secret Code required for registering with ROLE_MERCHANT
MERCHANT_INVITE_CODE=ESHOPPING_MERCHANT_INVITE_2026

# ------------------------------------------------------------------------------
# 4. Third-Party Integrations (Optional / Social Login)
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# ------------------------------------------------------------------------------
# 5. Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
VITE_API_GATEWAY_URL=http://localhost:8080

